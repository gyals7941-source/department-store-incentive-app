# 이 파일을 secrets.toml 로 복사해 값을 채운다. secrets.toml 은 저장소에 올라가지 않는다.
# Streamlit Cloud 에서는 앱 설정의 Secrets 칸에 같은 내용을 붙여넣는다.
#
# repo    : 데이터가 담길 비공개 저장소. 코드 저장소와 반드시 달라야 한다.
#           같은 곳에 두면 저장할 때마다 앱이 다시 배포된다.
# token   : GitHub 토큰. Settings → Developer settings →
#           Personal access tokens → Fine-grained tokens 에서 만든다.
#           Repository access 는 아래 repo 하나만, 권한은 Contents: Read and write.
# expires : 그 토큰의 만료일. 30일 남으면 앱이 설정 탭에서 알려준다.
[github]
repo    = "사용자명/department-store-incentive-data"
token   = "github_pat_..."
expires = "2027-11-18"

# 핀번호. 설정하면 앱을 열 때 이걸 묻는다. 비워 두면 묻지 않는다(사내 PC·로컬용).
# 주소가 공개돼 있으므로 숫자 4자리 말고 글자를 섞어 길게 쓰세요.
[app]
pin = "..."
